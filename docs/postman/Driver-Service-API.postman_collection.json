					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"john.doe@example.com\",\n  \"phoneNumber\": \"111-222-3333\",\n  \"latitude\": 37.7749,\n  \"longitude\": -122.4194,\n  \"vehicle\": {\n    \"make\": \"Ford\",\n    \"model\": \"Focus\",\n    \"licensePlate\": \"DUP123\",\n    \"color\": \"Red\"\n  }\n}"

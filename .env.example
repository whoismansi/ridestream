# copy to .env and fill in your own values:
#   cp .env.example .env
#
# .env is gitignored and must never be committed.
# docker compose reads .env automatically; for the maven services, export it first:
#   set -a && source .env && set +a

# postgres. choose any values you like; compose creates the database with them
# on first run and the services connect with the same credentials.
POSTGRES_DB=ridestream
POSTGRES_USER=<choose-a-username>
POSTGRES_PASSWORD=<choose-a-strong-password>

# pgadmin, only used by the optional dev-tools compose profile
PGADMIN_EMAIL=<your-email>
PGADMIN_PASSWORD=<choose-a-strong-password>

# optional connection overrides, defaults shown
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433

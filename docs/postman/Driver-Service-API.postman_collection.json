{
	"info": {
		"_postman_id": "ridestream-driver-service",
		"name": "RideStream - Driver Service API",
		"description": "Complete API collection for testing the Driver Service in RideStream application",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8081/api/drivers/health",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8081",
					"path": [
						"api",
						"drivers",
						"health"
					]
				},
				"description": "Check if the driver service is running"
			},
			"response": []
		},
		{
			"name": "2. Register New Driver",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Save driver ID for subsequent requests",
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    pm.environment.set(\"driver_id\", response.id);",
							"    pm.environment.set(\"driver_email\", response.email);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phoneNumber\": \"123-456-7890\",\n  \"latitude\": 37.7749,\n  \"longitude\": -122.4194,\n  \"vehicle\": {\n    \"make\": \"Toyota\",\n    \"model\": \"Camry\",\n    \"licensePlate\": \"ABC123\",\n    \"color\": \"Black\"\n  }\n}"
				},
				"url": {
					"raw": "http://localhost:8081/api/drivers",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8081",
					"path": [
						"api",
						"drivers"
					]
				},
				"description": "Register a new driver in the system"
			},
			"response": []
		},
		{
			"name": "3. Register Second Driver",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Save second driver ID",
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    pm.environment.set(\"driver_id_2\", response.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane.smith@example.com\",\n  \"phoneNumber\": \"987-654-3210\",\n  \"latitude\": 37.7849,\n  \"longitude\": -122.4094,\n  \"vehicle\": {\n    \"make\": \"Honda\",\n    \"model\": \"Accord\",\n    \"licensePlate\": \"XYZ789\",\n    \"color\": \"White\"\n  }\n}"
				},
				"url": {
					"raw": "http://localhost:8081/api/drivers",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8081",
					"path": [
						"api",
						"drivers"
					]
				},
				"description": "Register a second driver for testing"
			},
			"response": []
		},
